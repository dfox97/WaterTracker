@page "/"

<PageTitle>WaterTracker</PageTitle>

<div class="container py-5 text-center">
    <h1 class="display-4 mb-3">💧 WaterTracker</h1>
    <p class="lead text-muted mb-4">Track your daily water intake and stay hydrated.</p>

    <AuthorizeView>
        <Authorized>
            <a href="/tracker" class="btn btn-primary btn-lg">Go to My Tracker</a>
        </Authorized>
        <NotAuthorized>
            <a href="/Account/Register" class="btn btn-primary btn-lg me-2">Get Started</a>
            <a href="/Account/Login" class="btn btn-outline-secondary btn-lg">Log In</a>
        </NotAuthorized>
    </AuthorizeView>
</div>
